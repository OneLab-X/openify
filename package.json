{
  "name": "shopkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @shopkit/db generate",
    "db:migrate": "pnpm --filter @shopkit/api cli db:migrate",
    "openapi": "pnpm --filter @shopkit/api openapi:emit && pnpm --filter @shopkit/sdk generate",
    "sdk:check": "pnpm --filter @shopkit/api openapi:emit && pnpm --filter @shopkit/sdk check",
    "shopkit": "pnpm --filter @shopkit/api cli",
    "e2e": "pnpm --filter @shopkit/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "@shopkit/config": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6"
      }
    }
  }
}
