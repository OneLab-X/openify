# Generated by scripts/install.sh. BACK UP THIS FILE: losing SHOPKIT_MASTER_KEY makes stored
# provider secrets unrecoverable.
PUBLIC_URL=https://localhost
SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com
SHOPKIT_MASTER_KEY=          # 32 random bytes, base64:  openssl rand -base64 32
SHOPKIT_MASTER_KEY_VERSION=1
POSTGRES_PASSWORD=           # openssl rand -hex 24
SESSION_SECRET=              # openssl rand -hex 32
REVALIDATE_SECRET=           # openssl rand -hex 24
MEILISEARCH_MASTER_KEY=      # openssl rand -hex 24 (only used with the meilisearch profile)
# Optional
# HTTP_PORT=80
# HTTPS_PORT=443
# LOG_LEVEL=info
# MINIO_ACCESS_KEY=shopkit
# MINIO_SECRET_KEY=change-me-please
# Storefront search through Meilisearch instead of Postgres full-text:
# COMPOSE_PROFILES=meilisearch
# MEILISEARCH_URL=http://meilisearch:7700
