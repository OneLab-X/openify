{
  "name": "@shopkit/providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@shopkit/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "msw": "3.0.7",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
