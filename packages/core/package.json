{
  "name": "@shopkit/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/render": "2.2.0",
    "@shopkit/crypto": "workspace:*",
    "@shopkit/db": "workspace:*",
    "@shopkit/providers": "workspace:*",
    "@shopkit/theme-default": "workspace:*",
    "@shopkit/theme-sdk": "workspace:*",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "argon2": "0.45.2",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dompurify": "3.4.18",
    "ioredis": "6.0.0",
    "jsdom": "31.0.1",
    "meilisearch": "0.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@shopkit/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
